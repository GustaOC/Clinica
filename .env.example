# Supabase: Project Settings > API. Use the publishable/anon key, never service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing installations may instead use NEXT_SUPABASE_URL and NEXT_SUPABASE_ANON_KEY.
# Never configure or use SUPABASE_SERVICE_ROLE_KEY in the web application.

# Google AI Studio server key. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Keep empty to use gemini-3-pro-image (highest-quality professional editing).
GEMINI_IMAGE_MODEL=
